{
  "name": "headroom-cline-plugin",
  "version": "0.1.0",
  "description": "Cline plugin that compresses agent context with Headroom — fewer tokens, same answers, reversible.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "cline",
    "cline-plugin",
    "headroom",
    "context-compression",
    "tokens",
    "llm"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "cline": {
    "plugins": [
      {
        "paths": ["./src/index.ts"],
        "capabilities": ["tools", "hooks"]
      }
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "dependencies": {
    "headroom-ai": "^0.22.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "@cline/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@cline/sdk": {
      "optional": true
    }
  }
}
